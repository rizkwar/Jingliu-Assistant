#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
if [ -x .venv/Scripts/python.exe ]; then
  python_command=.venv/Scripts/python.exe
elif [ -x .venv/bin/python ]; then
  python_command=.venv/bin/python
elif command -v python3 >/dev/null 2>&1; then
  python_command=python3
else
  python_command=python
fi
"$python_command" scripts/check_publish_safety.py --history
if [ -x .cache/privacy-tools/gitleaks/gitleaks.exe ]; then
  .cache/privacy-tools/gitleaks/gitleaks.exe git --redact=100 --no-banner --log-opts='--all' .
elif command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --redact=100 --no-banner --log-opts='--all' .
fi
