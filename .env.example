OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Choose ChatGPT subscription via Codex in Settings; do not paste ChatGPT tokens here.
CHARACTER_PROFILE=character.toml
TTS_VOICE=reference
TTS_ENABLED=true
TTS_VOLUME=70
TTS_RATE=100
# Keep this local recording at the selected path; voice audio is excluded from Git.
TTS_REFERENCE=voices/jingliu-reference.wav
# Optional Hugging Face read token for the full Pocket TTS model; never commit it.
HF_TOKEN=
STT_MODEL=base.en
STT_AUTO_SEND=true
STT_MICROPHONE=

