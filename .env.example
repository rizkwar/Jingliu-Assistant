OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
CHARACTER_PROFILE=character.toml
TTS_VOICE=alba
TTS_ENABLED=true
TTS_VOLUME=70
TTS_RATE=100
